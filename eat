def meal(key, name, minutes, cheap, vegetarian, note, method=None, diet=None):
    item = dict(id=key, name=name, minutes=minutes, cheap=cheap,
                vegetarian=vegetarian, note=note)
    if method is not None:
        item["method"] = method
    if diet is not None:
        item["diet"] = diet
    return item


